# Public: visible in browser bundles. Leave unset for the foundation demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Primary evidence-backed compiler: ollama (default), ollama-cloud, or gemma.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Vercel/Ollama Cloud: set AI_PROVIDER=ollama-cloud and configure these server-side.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b
# Gemma and the connected MVP's OpenAI-compatible compiler.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional server-side metadata for reproducible extraction; never invent a license.
AI_MODEL_WEIGHTS_URL=
# Not needed for this foundation; provision only if a reviewed admin task requires it.
# SUPABASE_SERVICE_ROLE_KEY=
